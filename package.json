{
  "name": "city-builder",
  "version": "1.0.0",
  "description": "Dynamic City Builder",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:beta": "node tools/release_build.js",
    "preview": "vite preview",
    "test": "node scripts/smoke_test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "validate": "node scripts/validate_content.mjs",
    "lint:basic": "node scripts/lint_basic.mjs",
    "check:no-math-random": "node scripts/check_no_math_random.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "electron:dev": "electron electron.cjs",
    "electron:build": "npm run build && electron-builder",
    "electron:pack": "electron-builder --dir",
    "mp:server": "node server/multiplayer_server.js",
    "mp:server:dev": "node --watch server/multiplayer_server.js",
    "greenworks:rebuild": "node_modules/.bin/electron-rebuild -f -w greenworks"
  },
  "main": "electron.cjs",
  "build": {
    "appId": "com.nonta.city-builder",
    "productName": "City Builder",
    "directories": {
      "buildResources": "public",
      "output": "dist-electron"
    },
    "files": [
      "build/**/*",
      "electron.cjs",
      "electron-preload.cjs",
      "steam_appid.txt",
      "greenworks.json",
      "node_modules/greenworks/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false
    }
  },
  "keywords": [
    "city-builder"
  ],
  "license": "MIT",
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.19.3",
    "@rollup/rollup-win32-x64-msvc": "^4.59.0",
    "three": "^0.160.0",
    "tone": "^15.1.22"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@sveltejs/vite-plugin-svelte": "^3.1.2",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/cli": "^2.10.1",
    "electron": "^41.0.2",
    "electron-builder": "^26.8.1",
    "glob": "^10.0.0",
    "svelte": "^4.2.20",
    "typescript": "^5.9.3",
    "vite": "^5.0.0",
    "ws": "^8.19.0"
  }
}
