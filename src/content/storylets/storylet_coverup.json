{
  "id": "storylet_coverup_evidence",
  "tags": ["coverup", "evidence", "danger"],
  "requires": {
    "citizenStatus": ["frightened"],
    "securityLevel": "high"
  },
  "provides": ["clue:hidden_evidence", "clue:erased_record"],
  "weight": 0.5,
  "title": "Coverup Attempt",
  "description": "Someone is trying to erase evidence of wrongdoing.",
  "steps": [
    {
      "id": "start",
      "kind": "trigger",
      "trigger": "ANOMALY_COVERUP"
    },
    {
      "id": "recover_data",
      "kind": "hack_node",
      "nodeType": "TELECOM_BOX",
      "onComplete": ["spawn_clue:data_recovery"]
    },
    {
      "id": "find_hidden",
      "kind": "go_to",
      "marker": "hidden_cache"
    },
    {
      "id": "resolve",
      "kind": "outcome",
      "outcomes": [
        {"id": "evidence_preserved", "label": "Evidence preserved", "effect": ["district_transparency_up"]}
      ]
    }
  ]
}
