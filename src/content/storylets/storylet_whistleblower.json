{
  "id": "storylet_whistleblower_secure",
  "tags": ["whistleblower", "protection", "justice"],
  "requires": {
    "citizenStatus": ["displeased"],
    "securityLevel": "low"
  },
  "provides": ["clue:confession", "clue:evidence"],
  "weight": 0.6,
  "title": "Secure Whistleblower",
  "description": "A citizen has crucial information but fears speaking out.",
  "steps": [
    {
      "id": "start",
      "kind": "trigger",
      "trigger": "ANOMALY_WHISTLEBLOWER_REQUEST"
    },
    {
      "id": "secure_channel",
      "kind": "hack_node",
      "nodeType": "TELECOM_BOX",
      "onComplete": ["spawn_clue:encrypted_message"]
    },
    {
      "id": "meet",
      "kind": "go_to",
      "marker": "safe_meeting"
    },
    {
      "id": "resolve",
      "kind": "outcome",
      "outcomes": [
        {"id": "testimony_received", "label": "Receive testimony", "effect": ["district_justice_up"]}
      ]
    }
  ]
}
