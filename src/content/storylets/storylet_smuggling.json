{
  "id": "storylet_smuggling_goods",
  "tags": ["smuggling", "trade", "crime"],
  "requires": {
    "districtTypes": ["commercial", "industrial"],
    "borderAccess": true
  },
  "provides": ["clue:contraband_list", "clue:smuggler_route"],
  "weight": 0.6,
  "title": "Goods Smuggling",
  "description": "Illicit goods are being smuggled through the district.",
  "steps": [
    {
      "id": "start",
      "kind": "trigger",
      "trigger": "ANOMALY_SMUGGLING"
    },
    {
      "id": "inspect_warehouse",
      "kind": "hack_node",
      "nodeType": "TELECOM_BOX",
      "onComplete": ["spawn_clue:shipment_log"]
    },
    {
      "id": "intercept",
      "kind": "go_to",
      "marker": "smuggling_point"
    },
    {
      "id": "resolve",
      "kind": "outcome",
      "outcomes": [
        {"id": "smuggling_stopped", "label": "Smuggling disrupted", "effect": ["district_trade_up"]}
      ]
    }
  ]
}
