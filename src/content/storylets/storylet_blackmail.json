{
  "id": "storylet_blackmail_citizen",
  "tags": ["blackmail", "personal", "investigation"],
  "requires": {
    "citizenStatus": ["stressed"],
    "securityLevel": "medium"
  },
  "provides": ["clue:blackmail_letter", "clue:creditor"],
  "weight": 0.55,
  "title": "Citizen Blackmail",
  "description": "A citizen is being extorted by an unknown party.",
  "steps": [
    {
      "id": "start",
      "kind": "trigger",
      "trigger": "ANOMALY_BLACKMAIL"
    },
    {
      "id": "trace_payment",
      "kind": "hack_node",
      "nodeType": "TELECOM_BOX",
      "onComplete": ["spawn_clue:payment_trace"]
    },
    {
      "id": "resolve",
      "kind": "outcome",
      "outcomes": [
        {"id": "blackmail_thwarted", "label": "Blackmail stopped", "effect": ["citizen安全感_up"]}
      ]
    }
  ]
}
