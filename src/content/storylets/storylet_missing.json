{
  "id": "storylet_missing_person",
  "tags": ["missing", "investigation", "residential"],
  "requires": {
    "districtTypes": ["residential"],
    "citizenStatus": ["active"]
  },
  "provides": ["clue:last_seen", "clue:witness"],
  "weight": 0.9,
  "title": "Missing Citizen",
  "description": "A citizen has disappeared from their home.",
  "steps": [
    {
      "id": "start",
      "kind": "trigger",
      "trigger": "ANOMALY_MISSING_PERSON"
    },
    {
      "id": "check_cctv",
      "kind": "hack_node",
      "nodeType": "CCTV",
      "onComplete": ["spawn_clue:cctv_clip"]
    },
    {
      "id": "resolve",
      "kind": "outcome",
      "outcomes": [
        {"id": "missing_found", "label": "Citizen found safe", "effect": ["district_stability_up"]},
        {"id": "missing_tragic", "label": "Tragic outcome", "effect": ["district_stability_down"]}
      ]
    }
  ]
}
