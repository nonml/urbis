{
  "id": "case_corruption",
  "type": "casefile",
  "title": "The Corruption Trail",
  "description": "Rumors of officials taking bribes have surfaced. Follow the money to expose the network.",
  "tags": ["corruption", "finance", "officials", "investigation"],
  "steps": [
    {
      "id": "start",
      "kind": "trigger",
      "trigger": "ANOMALY_CORRUPTION_RUMOR",
      "text": "Whistleblower reports officials taking bribes",
      "completeOn": 1
    },
    {
      "id": "clue1_finance",
      "kind": "hack_node",
      "nodeType": "TELECOM_BOX",
      "text": "Hack telecom to access financial transaction logs",
      "onComplete": ["spawn_clue:transaction_log", "advance:trace_money"],
      "completeOn": 1
    },
    {
      "id": "trace_money",
      "kind": "go_to",
      "marker": "suspicious_building",
      "text": "Follow money trail to suspicious building",
      "completeOn": 1
    },
    {
      "id": "clue2_cctv",
      "kind": "hack_node",
      "nodeType": "CCTV",
      "text": "Hack CCTV to see who enters the building",
      "onComplete": ["spawn_clue:visual_evidence", "advance:confront"],
      "completeOn": 1
    },
    {
      "id": "confront",
      "kind": "investigate",
      "text": "Confront the involved officials",
      "completeOn": 1
    },
    {
      "id": "choice_expose",
      "kind": "choice",
      "text": "How do you handle the exposure?",
      "choices": [
        {
          "id": "public_exposure",
          "label": "Expose publicly",
          "effect": ["reputation_high", "heat_rival_low", "district_order_up"],
          "nextStep": "resolve_public"
        },
        {
          "id": "quiet_removal",
          "label": "Quiet official removal",
          "effect": ["district_order_up", "reputation_neutral", "heat_rival_neutral"],
          "nextStep": "resolve_quiet"
        }
      ]
    },
    {
      "id": "resolve_public",
      "kind": "outcome",
      "outcomes": [
        {
          "id": "exposure_success",
          "label": "Success - officials removed",
          "effect": ["district_corruption_down", "reputation_high"]
        }
      ]
    },
    {
      "id": "resolve_quiet",
      "kind": "outcome",
      "outcomes": [
        {
          "id": "quiet_success",
          "label": "Quiet resolution achieved",
          "effect": ["district_corruption_down", "reputation_neutral"]
        }
      ]
    }
  ]
}
