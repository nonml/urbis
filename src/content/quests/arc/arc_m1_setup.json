{
    "id": "arc_m1_setup",
    "type": "arc_mission",
    "arcId": "main_arc",
    "missionIndex": 1,
    "title": "First Cut",
    "description": "The fixer wants a small thing done quietly. Either you can handle a courier run or you can't — and that decides what comes next.",
    "tags": ["arc", "main_arc", "setup", "tutorial-bridge"],
    "trigger": "ARC_M1_RADIO_HAIL",
    "openingCinematic": "intro_pan",
    "rewards": [
        { "type": "add_resource", "resource": "gold", "amount": 50 },
        { "type": "set_flag", "flag": "arc_m1_complete" },
        { "type": "rep_delta", "faction": "fixer_network", "amount": 5 }
    ],
    "steps": [
        {
            "id": "start",
            "kind": "trigger",
            "trigger": "ARC_M1_RADIO_HAIL",
            "speaker": "fixer",
            "text": "A new voice cuts in over the radio. Says they have something for you.",
            "completeOn": 1
        },
        {
            "id": "go_to_meet",
            "kind": "go_to",
            "marker": "fixer_meet_alley",
            "text": "Meet the fixer at the alley off Hartwell.",
            "completeOn": 1
        },
        {
            "id": "meet_fixer",
            "kind": "interact",
            "speaker": "fixer",
            "text": "The fixer hands you a comms tag. \"Pull the data off the telecom box on 4th. Don't be seen.\"",
            "completeOn": 1
        },
        {
            "id": "hack_telecom",
            "kind": "hack_node",
            "nodeType": "TELECOM_BOX",
            "text": "Pull the data packet from the telecom box on 4th.",
            "onComplete": ["spawn_clue:fixer_data_packet", "advance:choice_handle"],
            "completeOn": 1
        },
        {
            "id": "choice_handle",
            "kind": "choice",
            "text": "The packet is small. You could read it first — or just deliver it.",
            "choices": [
                {
                    "id": "deliver_clean",
                    "label": "Deliver clean. No questions.",
                    "effect": ["fixer_trust_up", "reputation_neutral"],
                    "nextStep": "deliver"
                },
                {
                    "id": "skim_first",
                    "label": "Skim the contents on the way.",
                    "effect": ["self_intel_up", "fixer_trust_neutral", "heat_minor"],
                    "nextStep": "deliver"
                }
            ]
        },
        {
            "id": "deliver",
            "kind": "go_to",
            "marker": "fixer_dropoff",
            "text": "Drop the packet at the dead-letter box behind Static FM's antenna.",
            "completeOn": 1
        },
        {
            "id": "resolve",
            "kind": "outcome",
            "outcomes": [
                {
                    "id": "first_cut_done",
                    "label": "First job done. The fixer marks you as workable.",
                    "effect": ["arc_m1_complete", "unlock:arc_m2_recruitment"]
                }
            ]
        }
    ]
}
