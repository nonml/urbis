{
    "id": "arc_m3_planning",
    "type": "arc_mission",
    "arcId": "main_arc",
    "missionIndex": 3,
    "difficulty": 4,
    "title": "Sand Table",
    "description": "Three of you, one target, a week to plan it. The route, the entry, the exit — every variable you don't pick now becomes a problem you can't fix later.",
    "tags": ["arc", "main_arc", "planning", "heist"],
    "trigger": "ARC_M3_BRIEFING",
    "requires": ["arc_m2_complete"],
    "rewards": [
        { "type": "add_resource", "resource": "gold", "amount": 60 },
        { "type": "set_flag", "flag": "arc_m3_complete" },
        { "type": "rep_delta", "faction": "fixer_network", "amount": 6 }
    ],
    "steps": [
        {
            "id": "start",
            "kind": "trigger",
            "trigger": "ARC_M3_BRIEFING",
            "speaker": "fixer",
            "text": "Fixer pings cold and direct. \"Target's locked. We need to plan this one. Tonight.\"",
            "completeOn": 1
        },
        {
            "id": "go_to_safehouse",
            "kind": "go_to",
            "marker": "safe_meeting",
            "text": "Get to the safehouse. The whole team's already there.",
            "completeOn": 1
        },
        {
            "id": "table_briefing",
            "kind": "interact",
            "speaker": "fixer",
            "text": "\"Concourse Tower. Vault floor, twenty-third. Three approaches I can stomach. You pick.\"",
            "completeOn": 1
        },
        {
            "id": "recon_cameras",
            "kind": "hack_node",
            "nodeType": "CCTV",
            "text": "Before anyone commits, pull the lobby and freight-elevator feeds from the tower's CCTV grid.",
            "onComplete": ["spawn_clue:tower_recon", "advance:choice_approach"],
            "completeOn": 1
        },
        {
            "id": "choice_approach",
            "kind": "choice",
            "text": "How does the team take the tower?",
            "choices": [
                {
                    "id": "approach_stealth",
                    "label": "Stealth — service shaft up, no shots fired, no faces seen.",
                    "effect": ["set_flag:plan=stealth", "team_archetype_quiet"],
                    "nextStep": "stage_stealth"
                },
                {
                    "id": "approach_loud",
                    "label": "Loud — front door, drop the lobby, out before response arrives.",
                    "effect": ["set_flag:plan=loud", "team_archetype_loud"],
                    "nextStep": "stage_loud"
                },
                {
                    "id": "approach_inside",
                    "label": "Inside job — flip a guard, walk in clean, leave before anyone counts.",
                    "effect": ["set_flag:plan=inside", "team_archetype_inside"],
                    "nextStep": "stage_inside"
                }
            ]
        },
        {
            "id": "stage_stealth",
            "kind": "investigate",
            "text": "Trace the service shaft from the alley dumpster. Note the tool you'd need at each landing.",
            "onComplete": ["spawn_clue:stealth_route", "advance:dry_run"],
            "completeOn": 1
        },
        {
            "id": "stage_loud",
            "kind": "go_to",
            "marker": "suspicious_building",
            "text": "Walk the front block. Time the patrols, find the cleanest exit lane.",
            "onComplete": ["spawn_clue:loud_route", "advance:dry_run"],
            "completeOn": 1
        },
        {
            "id": "stage_inside",
            "kind": "interact",
            "speaker": "informant",
            "text": "Meet the bent guard at the deli on 9th. He needs to believe you'll cover him after the score.",
            "onComplete": ["spawn_clue:inside_contact", "advance:dry_run"],
            "completeOn": 1
        },
        {
            "id": "dry_run",
            "kind": "interact",
            "speaker": "fixer",
            "text": "Round the table again. Walk the plan back top to bottom, no steps skipped, every contingency named.",
            "completeOn": 1
        },
        {
            "id": "resolve",
            "kind": "outcome",
            "outcomes": [
                {
                    "id": "plan_locked",
                    "label": "Plan locked. The crew sleeps on it. Tomorrow, the job moves.",
                    "effect": ["arc_m3_complete", "unlock:arc_m4_heist"]
                }
            ]
        }
    ]
}
