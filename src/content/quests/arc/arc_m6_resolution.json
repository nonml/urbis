{
    "id": "arc_m6_resolution",
    "type": "arc_mission",
    "arcId": "main_arc",
    "missionIndex": 6,
    "title": "Last Move",
    "description": "The fixer's gone. The crew's scattered. The city's got your heat signature painted on every wall. One last move to clean this up — or walk away.",
    "tags": ["arc", "main_arc", "resolution", "finale"],
    "trigger": "ARC_M6_RESOLUTION",
    "requires": ["arc_m5_complete"],
    "rewards": [
        { "type": "add_resource", "resource": "gold", "amount": 200 },
        { "type": "set_flag", "flag": "arc_complete" },
        { "type": "set_flag", "flag": "main_arc_done" },
        { "type": "rep_delta", "faction": "fixer_network", "amount": 15 },
        { "type": "modify_heat", "delta": -15 }
    ],
    "steps": [
        {
            "id": "start",
            "kind": "trigger",
            "trigger": "ARC_M6_RESOLUTION",
            "speaker": "unknown",
            "text": "Anonymous ping. Coordinates only. One hour. Come alone or don't come at all.",
            "completeOn": 1
        },
        {
            "id": "go_to_meeting",
            "kind": "go_to",
            "marker": "final_meeting",
            "text": "Move to the coordinates. The city feels different — tighter, watching.",
            "completeOn": 1
        },
        {
            "id": "reveal",
            "kind": "interact",
            "speaker": "mysterious_contact",
            "text": "\"The fixer was mine. The plan was mine. You were the variable I couldn't calculate.\"",
            "completeOn": 1
        },
        {
            "id": "choice_final",
            "kind": "choice",
            "text": "The mastermind offers you a choice. How do you end this?",
            "choices": [
                {
                    "id": "accept_deal",
                    "label": "Take the deal. Work together. Build something bigger.",
                    "effect": ["set_flag:end=partner", "reputation_allied", "heat_cleared"],
                    "nextStep": "end_partner"
                },
                {
                    "id": "burn_it",
                    "label": "Burn it all. Take the package, disappear, never look back.",
                    "effect": ["set_flag:end=ghost", "reputation_legend", "heat_max"],
                    "nextStep": "end_ghost"
                },
                {
                    "id": "turn_state",
                    "label": "Flip the table. Hand everything to the authorities.",
                    "effect": ["set_flag:end=whistleblower", "reputation_hero", "heat_zero"],
                    "nextStep": "end_whistleblower"
                }
            ]
        },
        {
            "id": "end_partner",
            "kind": "outcome",
            "outcomes": [
                {
                    "id": "partner_ending",
                    "label": "You become the fixer's equal. The city gets a new player.",
                    "effect": ["arc_ending=partner", "unlock_epilogue_partner"]
                }
            ]
        },
        {
            "id": "end_ghost",
            "kind": "outcome",
            "outcomes": [
                {
                    "id": "ghost_ending",
                    "label": "Vanish into the static. They'll tell stories about you.",
                    "effect": ["arc_ending=ghost", "unlock_epilogue_ghost"]
                }
            ]
        },
        {
            "id": "end_whistleblower",
            "kind": "outcome",
            "outcomes": [
                {
                    "id": "whistleblower_ending",
                    "label": "The system wins. But you changed it from the inside.",
                    "effect": ["arc_ending=whistleblower", "unlock_epilogue_whistleblower"]
                }
            ]
        },
        {
            "id": "resolve",
            "kind": "outcome",
            "outcomes": [
                {
                    "id": "arc_complete",
                    "label": "The arc ends. What you built remains.",
                    "effect": ["arc_m6_complete", "main_arc_done"]
                }
            ]
        }
    ]
}
