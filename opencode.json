{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "external_directory": "deny",
    "bash": {
      "*": "allow",
      "*playwright test*": "deny",
      "*npm test*": "deny",
      "*npm run gate*": "deny",
      "*playwright test tests/*.spec.js*": "allow",
      "*playwright test tests/*.test.js*": "allow",
      "*playwright test tests/accept/*.js*": "allow"
    }
  }
}
